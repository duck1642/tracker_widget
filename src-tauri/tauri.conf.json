{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tracker-widget",
  "version": "1.1.0",
  "identifier": "com.desktop.tracker-widget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tracker Widget",
        "width": 960,
        "height": 700,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "minWidth": 480,
        "minHeight": 360,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
